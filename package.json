{
  "name": "sumbible",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "tsx scripts/build-cross-reference-index.ts && tsx scripts/build-book-context.ts",
    "build": "astro build && pagefind --site dist && node scripts/copy-pagefind.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "new-chapter": "tsx scripts/new-chapter.ts",
    "promote-content": "tsx scripts/promote-content.ts",
    "promote-chapter": "tsx scripts/promote-content.ts --kind chapter",
    "lint:content": "tsx scripts/lint-content.ts",
    "new-book": "tsx scripts/new-book.ts",
    "new-canon": "tsx scripts/new-canon.ts",
    "build-favicons": "tsx scripts/build-favicons.ts",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx astro check && npm run lint:content"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.7",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.7",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.9.1",
    "astro-og-canvas": "^0.11.1",
    "canvaskit-wasm": "^0.41.1",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
