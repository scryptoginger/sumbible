---
// A horizontal divider with an alpha-omega centerpiece. Used between major
// sections on chapter, home, and About pages.
import AlphaOmega from './icons/AlphaOmega.astro';
---

<div class="my-10 flex items-center justify-center gap-4 text-stone-400">
  <span class="h-px flex-1 bg-stone-300"></span>
  <AlphaOmega size={20} class="opacity-60" />
  <span class="h-px flex-1 bg-stone-300"></span>
</div>
