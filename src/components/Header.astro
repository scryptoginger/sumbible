---
import { canons, canonSlugs } from '../lib/canons';
import ChiRho from './icons/ChiRho.astro';
import IconTooltip from './IconTooltip.astro';

const path = Astro.url.pathname;

// Primary nav: the five canons get their own (larger) row.
const canonLinks = canonSlugs.map((slug) => ({
  href: `/${slug}`,
  label: canons[slug].name,
}));

// Secondary nav: everything else, slightly smaller, on its own row beneath.
const otherLinks: { href: string; label: string; feature: boolean }[] = [
  { href: '/christ', label: 'Christ', feature: true },
  { href: '/themes', label: 'Themes', feature: true },
  { href: '/related-texts', label: 'Related Texts', feature: false },
  { href: '/about', label: 'About', feature: false },
];

function isActive(href: string): boolean {
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="border-b border-stone-300">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-5">
    {/* Icon and wordmark are siblings, not nested in one <a>: HTML5 forbids
        nested anchors, and IconTooltip's "Learn more →" link inside the
        popover would otherwise be extracted by the browser's auto-fixup. */}
    <div class="flex items-center gap-2.5">
      <IconTooltip
        title="Chi-Rho"
        description="An early Christian Christogram from the first two Greek letters of Christ's name (Χριστός). SumBible's mark."
        learnMoreHref="/about/iconography/chi-rho"
        align="start"
      >
        <ChiRho size={30} class="shrink-0 text-accent" />
      </IconTooltip>
      <a href="/" class="block">
        <span class="block text-2xl font-bold leading-none tracking-tight text-accent">SumBible</span>
        <span class="mt-1 block text-xs text-stone-500">
          Chapter-by-chapter summaries, enriched by Hebrew, Greek, and many translations
        </span>
      </a>
    </div>

    <div class="flex items-center gap-2">
      <button
        id="search-toggle"
        type="button"
        class="cursor-pointer rounded p-2 text-stone-600 ring-1 ring-stone-300 hover:text-accent"
        aria-label="Search SumBible"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </button>

      {/* Mobile nav toggle — JS-driven (the prior checkbox-hack relied on the
          input and nav being siblings, which they're not in this layout). */}
      <button
        id="nav-toggle"
        type="button"
        class="cursor-pointer rounded p-2 text-stone-600 ring-1 ring-stone-300 select-none md:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>

    <nav id="primary-nav" class="hidden w-full md:!block md:w-auto" aria-label="Primary">
      {/* Desktop: two stacked rows on the right (canons primary, others
          secondary). Mobile (peer-checked hamburger menu): single vertical
          list with the canons grouped first, then the other links. */}
      <div class="flex flex-col gap-1.5 md:items-end">
        {/* Row 1 — Canons (primary) */}
        <ul class="flex flex-col gap-1 text-sm md:flex-row md:items-center md:gap-5">
          {canonLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'rounded px-2 py-1 hover:text-accent',
                  isActive(link.href) ? 'font-semibold text-accent' : 'text-stone-700',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        {/* Row 2 — Other links (secondary, slightly smaller on desktop) */}
        <ul class="flex flex-col gap-1 text-sm md:flex-row md:items-center md:gap-4 md:text-xs">
          {otherLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'rounded px-2 py-1 hover:text-accent',
                  isActive(link.href)
                    ? 'font-semibold text-accent'
                    : link.feature
                      ? 'text-accent/80'
                      : 'text-stone-500',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>

  {/* Search modal — Pagefind UI is loaded lazily on first open. */}
  <div
    id="search-modal"
    class="fixed inset-0 z-50 hidden bg-black/40 p-4 pt-16 sm:pt-24"
  >
    <div class="mx-auto max-w-xl rounded-lg border border-stone-300 bg-parchment p-4 shadow-xl">
      <div class="mb-2 flex items-center justify-between">
        <span class="text-sm font-semibold text-stone-500">Search SumBible</span>
        <button
          id="search-close"
          type="button"
          class="cursor-pointer px-2 text-stone-400 hover:text-accent"
          aria-label="Close search"
        >&#x2715;</button>
      </div>
      <div id="search"></div>
    </div>
  </div>
</header>

<script>
  // Mobile nav toggle. The desktop md:!block override keeps the nav visible
  // at md+ regardless of the hidden class, so JS only manages mobile state.
  const navToggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  function setNavOpen(open: boolean) {
    if (!nav || !navToggle) return;
    nav.classList.toggle('hidden', !open);
    navToggle.setAttribute('aria-expanded', String(open));
  }
  navToggle?.addEventListener('click', () => {
    setNavOpen(nav?.classList.contains('hidden') ?? false);
  });
  // Tapping a nav link closes the menu (mobile-only matters; on desktop the
  // nav is always visible and the click just follows the link).
  nav?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setNavOpen(false));
  });

  // Pagefind search: the UI bundle and CSS live in /pagefind/, which only
  // exists after `pagefind` runs in the build — so they are loaded lazily,
  // at runtime, on the first time the modal is opened.
  const toggle = document.getElementById('search-toggle');
  const closeBtn = document.getElementById('search-close');
  const modal = document.getElementById('search-modal');
  let loaded = false;

  async function loadPagefind() {
    if (loaded || !modal) return;
    loaded = true;
    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(css);
    try {
      const uiUrl = '/pagefind/pagefind-ui.js';
      const mod: any = await import(/* @vite-ignore */ uiUrl);
      new mod.PagefindUI({ element: '#search', showSubResults: true });
    } catch {
      const el = document.getElementById('search');
      if (el) el.textContent = 'Search is available on the built site.';
    }
  }

  function open() {
    modal?.classList.remove('hidden');
    loadPagefind();
    window.setTimeout(() => modal?.querySelector('input')?.focus(), 250);
  }
  function close() {
    modal?.classList.add('hidden');
  }

  toggle?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>
