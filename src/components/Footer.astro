---
const repoUrl = 'https://github.com/scryptoginger/sumbible';
const year = new Date().getFullYear();
---

<footer class="border-t border-stone-300">
  <div class="mx-auto max-w-4xl px-4 py-8 text-sm text-stone-500">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <span class="font-semibold text-stone-700">SumBible</span>
      <a href="/about" class="hover:text-accent">About</a>
      <a href="/christ" class="hover:text-accent">Christ</a>
      <a href="/themes" class="hover:text-accent">Themes</a>
      <a href="/cross-references" class="hover:text-accent">Cross-references</a>
      <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent">GitHub</a>
      <span class="text-stone-400">© {year}</span>
    </div>
    <p class="mt-3 max-w-prose">
      SumBible is a study aid, not a replacement for personal scripture reading.
      Summaries link out to canonical editions for the scripture text itself.
    </p>
  </div>
</footer>
