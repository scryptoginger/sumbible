---
// A simple Latin cross, for general use where the chi-rho is too dense.
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 24, class: className = '', title = 'Cross' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  xmlns="http://www.w3.org/2000/svg"
  fill="currentColor"
  role="img"
  aria-label={title}
  class={className}
>
  <title>{title}</title>
  <rect x="42" y="10" width="16" height="80" rx="2" />
  <rect x="20" y="30" width="60" height="16" rx="2" />
</svg>
