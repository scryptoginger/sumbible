---
// Aleph (א) — the first letter of the Hebrew alphabet. Used as the Old
// Testament's emblem: the OT predates the Christian christogram, so the
// chi-rho is not the right symbol for it.
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className = '' } = Astro.props;
---

<span
  style={`font-size: ${size}px; line-height: 1; font-family: 'David Libre', 'Times New Roman', serif;`}
  class:list={['inline-block', className]}
  aria-label="Hebrew letter Aleph"
  role="img">א</span>
