---
// Ichthys — the fish, from the Greek acronym ΙΧΘΥΣ ("Jesus Christ, Son of
// God, Savior"). One of the earliest Christian symbols.
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const {
  size = 40,
  class: className = '',
  title = 'Ichthys — early Christian symbol',
} = Astro.props;
---

<svg
  width={size * 2}
  height={size}
  viewBox="0 0 200 80"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  stroke="currentColor"
  stroke-width="4"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={title}
  class={className}
>
  <title>{title}</title>
  {/* Fish body: two intersecting arcs */}
  <path d="M 10 40 Q 80 5 140 40 Q 80 75 10 40" />
  {/* Tail */}
  <path d="M 140 40 L 180 20 L 175 40 L 180 60 Z" />
</svg>
