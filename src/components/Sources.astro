---
interface Source {
  title: string;
  author?: string;
  url?: string;
  note?: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="mt-12 border-t border-stone-300 pt-6">
    <h3 class="text-sm font-semibold uppercase tracking-wider text-stone-500">Sources</h3>
    <ul class="mt-3 space-y-2 text-sm text-stone-700">
      {sources.map((src) => (
        <li>
          {src.author && <span class="font-medium">{src.author}, </span>}
          {src.url ? (
            <a href={src.url} target="_blank" rel="noopener noreferrer" class="italic underline decoration-stone-400 decoration-1 hover:decoration-stone-700">{src.title}</a>
          ) : (
            <span class="italic">{src.title}</span>
          )}
          {src.note && <span class="text-stone-500"> — {src.note}</span>}
        </li>
      ))}
    </ul>
  </section>
)}
