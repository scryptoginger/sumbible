---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { canons, type CanonSlug } from '../../../lib/canons';
import LangNote from '../../../components/LangNote.astro';
import LangNotes from '../../../components/LangNotes.astro';
import TranslationCompare from '../../../components/TranslationCompare.astro';
import VerseRef from '../../../components/VerseRef.astro';
import ScriptureBlock from '../../../components/ScriptureBlock.astro';
import Sources from '../../../components/Sources.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import SectionDivider from '../../../components/SectionDivider.astro';

export const getStaticPaths = (async () => {
  const all = await getCollection('chapters');

  // Group entries by book so each chapter knows its in-book neighbours.
  const byBook = new Map<string, CollectionEntry<'chapters'>[]>();
  for (const e of all) {
    const key = `${e.data.canon}/${e.data.bookSlug}`;
    const list = byBook.get(key) ?? [];
    list.push(e);
    byBook.set(key, list);
  }
  for (const list of byBook.values()) {
    list.sort((a, b) => a.data.chapter - b.data.chapter);
  }

  return all.map((entry) => {
    const list = byBook.get(`${entry.data.canon}/${entry.data.bookSlug}`)!;
    const idx = list.findIndex((e) => e.id === entry.id);
    return {
      params: {
        canon: entry.data.canon,
        book: entry.data.bookSlug,
        chapter: String(entry.data.chapter),
      },
      props: {
        entry,
        prevChapter: idx > 0 ? list[idx - 1].data.chapter : null,
        nextChapter: idx < list.length - 1 ? list[idx + 1].data.chapter : null,
      },
    };
  });
}) satisfies GetStaticPaths;

type Props = {
  entry: CollectionEntry<'chapters'>;
  prevChapter: number | null;
  nextChapter: number | null;
};

const { entry, prevChapter, nextChapter } = Astro.props as Props;
const data = entry.data;
const { Content } = await render(entry);

const canonData = canons[data.canon as CanonSlug];
const unit = data.canon === 'doctrine-and-covenants' ? 'Section' : 'Chapter';
const bookLabel =
  data.canon === 'doctrine-and-covenants' ? 'Doctrine and Covenants' : data.book;
const heading = `${bookLabel} ${data.chapter}`;
const bookHref = `/${data.canon}/${data.bookSlug}`;

const extLinkDefs = [
  { key: 'churchofjesuschrist', label: 'ChurchofJesusChrist.org' },
  { key: 'biblegateway', label: 'Bible Gateway' },
  { key: 'bibleHub', label: 'Bible Hub' },
  { key: 'blueLetterBible', label: 'Blue Letter Bible' },
  { key: 'netBible', label: 'NET Bible' },
] as const;
const links = extLinkDefs
  .filter((d) => Boolean(data.externalLinks[d.key]))
  .map((d) => ({ label: d.label, url: data.externalLinks[d.key]! }));

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Structured data — emitted only for published chapters, so draft summaries
// are not advertised to search engines as authoritative.
const jsonLd =
  data.status === 'published'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: data.title ? `${heading} — ${data.title}` : heading,
        datePublished: data.reviewedOn ?? data.draftedOn,
        dateModified: data.reviewedOn ?? data.draftedOn,
        author: { '@type': 'Organization', name: 'SumBible' },
        publisher: { '@type': 'Organization', name: 'SumBible' },
        mainEntityOfPage: pageUrl,
        about: `${data.book} chapter ${data.chapter}, scripture summary`,
      }
    : null;
---

<BaseLayout
  title={heading}
  description={data.highlightSummary}
  noindex={data.status !== 'published'}
  ogType="article"
  ogImage={`/og/${data.canon}/${data.bookSlug}/${data.chapter}.png`}
>
  {
    jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )
  }
  <nav class="text-sm text-stone-500" aria-label="Breadcrumb">
    <a href={`/${data.canon}`} class="hover:text-accent">{canonData.name}</a>
    <span class="mx-1.5 text-stone-400">&rsaquo;</span>
    <a href={bookHref} class="hover:text-accent">{data.book}</a>
    <span class="mx-1.5 text-stone-400">&rsaquo;</span>
    <span class="text-stone-700">{unit} {data.chapter}</span>
  </nav>

  <div data-pagefind-body data-pagefind-meta={`canon:${canonData.name}`}>
  <header class="mt-4">
    <h1 class="text-3xl font-bold text-ink sm:text-4xl">
      {heading}<StatusBadge status={data.status} />
    </h1>
    {
      data.title && (
        <p class="mt-1 text-xl text-accent italic">{data.title}</p>
      )
    }
  </header>

  {
    links.length > 0 && (
      <div class="mt-5 text-sm" data-pagefind-ignore>
        <span class="text-stone-500">Read this {unit.toLowerCase()} on: </span>
        {links.map((l, i) => (
          <>
            {i > 0 && <span class="mx-1 text-stone-300">·</span>}
            <a
              href={l.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent underline decoration-stone-300 underline-offset-2 hover:decoration-accent"
            >
              {l.label}
            </a>
          </>
        ))}
      </div>
    )
  }

  <SectionDivider />

  <section class="rounded-lg border border-stone-200 bg-stone-50/70 p-5">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-stone-500">
      Highlight
    </h2>
    <p class="mt-2 text-lg leading-relaxed text-ink">{data.highlightSummary}</p>
  </section>

  <SectionDivider />

  <article class="prose prose-stone max-w-none">
    <Content
      components={{ LangNote, LangNotes, TranslationCompare, VerseRef, ScriptureBlock }}
    />
  </article>
  </div>

  {data.sources.length > 0 && <SectionDivider />}

  <Sources sources={data.sources} />

  <p class="mt-8 text-sm">
    <a
      href={`https://github.com/scryptoginger/sumbible/issues/new?title=${encodeURIComponent(
        `Correction: ${heading}`,
      )}&body=${encodeURIComponent(
        `Chapter: ${pageUrl}\n\nCorrection:\n\n`,
      )}&labels=correction`}
      target="_blank"
      rel="noopener noreferrer"
      class="text-stone-500 underline decoration-dotted hover:text-stone-700"
    >
      Suggest a correction
    </a>
  </p>

  {
    data.christReferences.length > 0 && (
      <section class="mt-12 border-t border-stone-300 pt-6">
        <h2 class="text-sm font-semibold tracking-wider text-stone-500 uppercase">
          Names &amp; Titles of Christ in This Chapter
        </h2>
        <ul class="mt-3 space-y-4">
          {data.christReferences.map((ref) => (
            <li id={`v-${ref.verse}`} class="scroll-mt-24">
              <div class="flex flex-wrap items-baseline gap-x-3">
                <span class="font-medium text-accent">{ref.name}</span>
                <span class="text-xs text-stone-400">
                  verse {ref.verse} ·{' '}
                  <VerseRef book={data.bookSlug} chapter={data.chapter} verse={ref.verse} />
                </span>
              </div>
              {ref.note && <p class="mt-0.5 text-sm text-stone-600">{ref.note}</p>}
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-stone-400">
          Part of the cross-corpus <a href="/christ" class="underline hover:text-accent">references to Christ</a> index.
        </p>
      </section>
    )
  }

  <nav class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-stone-300 pt-6 text-sm">
    <span>
      {
        prevChapter !== null && (
          <a
            href={`${bookHref}/${prevChapter}`}
            class="text-accent hover:underline"
          >
            &larr; {bookLabel} {prevChapter}
          </a>
        )
      }
    </span>
    <a href={bookHref} class="text-stone-500 hover:text-accent">
      &larr; Back to {data.book}
    </a>
    <span>
      {
        nextChapter !== null && (
          <a
            href={`${bookHref}/${nextChapter}`}
            class="text-accent hover:underline"
          >
            {bookLabel} {nextChapter} &rarr;
          </a>
        )
      }
    </span>
  </nav>
</BaseLayout>

<script>
  import '../../../scripts/langnote-mobile.ts';
</script>
