---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionDivider from '../../../components/SectionDivider.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import Sources from '../../../components/Sources.astro';
import LangNote from '../../../components/LangNote.astro';
import LangNotes from '../../../components/LangNotes.astro';
import TranslationCompare from '../../../components/TranslationCompare.astro';
import VerseRef from '../../../components/VerseRef.astro';
import ScriptureBlock from '../../../components/ScriptureBlock.astro';
import { canons, canonSlugs, type BookMeta, type CanonSlug } from '../../../lib/canons';

export const getStaticPaths = (() => {
  const paths = [];
  for (const canon of canonSlugs) {
    for (const book of canons[canon].books) {
      paths.push({ params: { canon, book: book.slug }, props: { canon, book } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { canon, book } = Astro.props as { canon: CanonSlug; book: BookMeta };
const canonData = canons[canon];

const all = await getCollection('chapters');
const summaries = new Map<number, string>();
for (const e of all) {
  if (e.data.canon === canon && e.data.bookSlug === book.slug) {
    summaries.set(e.data.chapter, e.data.status);
  }
}

const bookEntry = (await getCollection('books')).find(
  (e) => e.data.canon === canon && e.data.bookSlug === book.slug,
);
const Content = bookEntry ? (await render(bookEntry)).Content : null;
const mdxComponents = { LangNote, LangNotes, TranslationCompare, VerseRef, ScriptureBlock };

const chapterNums = Array.from({ length: book.chapterCount }, (_, i) => i + 1);
const summarizedCount = summaries.size;
const unit = canon === 'doctrine-and-covenants' ? 'section' : 'chapter';
const hasMeta = Boolean(
  bookEntry?.data.authorshipNote ||
    bookEntry?.data.datingNote ||
    bookEntry?.data.literaryGenre,
);
const hasBody = Boolean(bookEntry && Content);
---

<BaseLayout title={book.name} wide>
  <nav class="text-sm text-stone-500" aria-label="Breadcrumb">
    <a href="/" class="hover:text-accent">Home</a>
    <span class="mx-1.5 text-stone-400">&rsaquo;</span>
    <a href={`/${canon}`} class="hover:text-accent">{canonData.name}</a>
    <span class="mx-1.5 text-stone-400">&rsaquo;</span>
    <span class="text-stone-700">{book.name}</span>
  </nav>

  <h1 class="mt-3 text-3xl font-bold text-ink">
    {book.name}{bookEntry && <StatusBadge status={bookEntry.data.status} />}
  </h1>
  {bookEntry?.data.subtitle && (
    <p class="mt-1 font-serif text-lg text-stone-600 italic">{bookEntry.data.subtitle}</p>
  )}
  <p class="mt-2 text-stone-500">
    {book.chapterCount} {unit}s ·{' '}
    {summarizedCount > 0 ? `${summarizedCount} summarized` : 'no summaries yet'}
  </p>

  <div class="mt-8 md:grid md:grid-cols-[2fr_3fr] md:items-start md:gap-8">
    {/* Section A: highlight + meta — mobile order 1; desktop col 1 row 1 */}
    {bookEntry && (
      <section class="space-y-4 md:col-start-1 md:row-start-1">
        <div class="rounded-lg border border-stone-200 bg-stone-50/70 p-5">
          <p class="leading-relaxed text-ink">{bookEntry.data.highlightSummary}</p>
        </div>
        {hasMeta && (
          <aside class="space-y-1 rounded border border-stone-200 bg-stone-50/40 p-4 text-sm">
            {bookEntry.data.authorshipNote && (
              <p>
                <span class="font-semibold text-stone-600">Authorship:</span>{' '}
                {bookEntry.data.authorshipNote}
              </p>
            )}
            {bookEntry.data.datingNote && (
              <p>
                <span class="font-semibold text-stone-600">Dating:</span>{' '}
                {bookEntry.data.datingNote}
              </p>
            )}
            {bookEntry.data.literaryGenre && (
              <p>
                <span class="font-semibold text-stone-600">Genre:</span>{' '}
                {bookEntry.data.literaryGenre}
              </p>
            )}
          </aside>
        )}
      </section>
    )}

    {/* Section B: chapter grid — mobile order 2; desktop col 2 spanning the rows */}
    <section
      class:list={[
        'mt-8 md:mt-0 md:col-start-2 md:row-start-1',
        hasBody && 'md:row-span-2',
        'md:sticky md:top-4 md:max-h-[calc(100vh-3rem)] md:overflow-y-auto',
      ]}
    >
      <h2 class="text-sm font-semibold tracking-wider text-stone-500 uppercase">
        {unit === 'section' ? 'Sections' : 'Chapters'}
      </h2>
      <ul class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-4 lg:grid-cols-5">
        {chapterNums.map((num) => {
          const status = summaries.get(num);
          const hasSummary = status !== undefined;
          const dot =
            status === 'draft'
              ? 'bg-amber-500'
              : status === 'review'
                ? 'bg-blue-500'
                : null;
          return (
            <li>
              {hasSummary ? (
                <a
                  href={`/${canon}/${book.slug}/${num}`}
                  class="relative flex aspect-square items-center justify-center rounded-md border border-stone-300 bg-stone-50 text-lg font-semibold text-ink transition hover:border-accent hover:text-accent"
                >
                  {num}
                  {dot && (
                    <span
                      class:list={['absolute right-1.5 top-1.5 h-2 w-2 rounded-full', dot]}
                      aria-hidden="true"
                    />
                  )}
                </a>
              ) : (
                <div
                  class="flex aspect-square items-center justify-center rounded-md border border-dashed border-stone-200 text-lg text-stone-300"
                  title="Summary coming soon"
                >
                  {num}
                </div>
              )}
            </li>
          );
        })}
      </ul>
      <p class="mt-4 text-xs text-stone-400">
        Numbered tiles without a link don&rsquo;t have a summary yet. A small
        <span class="mx-0.5 inline-block h-2 w-2 rounded-full bg-amber-500 align-middle"></span>
        marks a draft awaiting review;
        <span class="mx-0.5 inline-block h-2 w-2 rounded-full bg-blue-500 align-middle"></span>
        marks one in review.
      </p>
    </section>

    {/* Section C: deep summary + sources — mobile order 3; desktop col 1 row 2 */}
    {bookEntry && Content && (
      <section class="mt-8 md:col-start-1 md:row-start-2 md:mt-6">
        <SectionDivider />
        <article class="prose prose-stone max-w-none">
          <Content components={mdxComponents} />
        </article>
        {bookEntry.data.sources.length > 0 && <Sources sources={bookEntry.data.sources} />}
        <SectionDivider />
      </section>
    )}
  </div>
</BaseLayout>
