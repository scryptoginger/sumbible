---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SummaryCard from '../../../components/SummaryCard.astro';
import { canons, canonSlugs, type BookMeta, type CanonSlug } from '../../../lib/canons';
import { bookSummaries } from '../../../data/summaries';

export const getStaticPaths = (() => {
  const paths = [];
  for (const canon of canonSlugs) {
    for (const book of canons[canon].books) {
      paths.push({ params: { canon, book: book.slug }, props: { canon, book } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { canon, book } = Astro.props as { canon: CanonSlug; book: BookMeta };
const canonData = canons[canon];

const all = await getCollection('chapters');
const summaries = new Map<number, string>();
for (const e of all) {
  if (e.data.canon === canon && e.data.bookSlug === book.slug) {
    summaries.set(e.data.chapter, e.data.status);
  }
}

const bookSummary = bookSummaries[book.slug];
const chapterNums = Array.from({ length: book.chapterCount }, (_, i) => i + 1);
const summarizedCount = summaries.size;
const unit = canon === 'doctrine-and-covenants' ? 'section' : 'chapter';
---

<BaseLayout title={book.name}>
  <nav class="text-sm text-stone-500" aria-label="Breadcrumb">
    <a href="/" class="hover:text-accent">Home</a>
    <span class="mx-1.5 text-stone-400">&rsaquo;</span>
    <a href={`/${canon}`} class="hover:text-accent">{canonData.name}</a>
    <span class="mx-1.5 text-stone-400">&rsaquo;</span>
    <span class="text-stone-700">{book.name}</span>
  </nav>

  <h1 class="mt-3 text-3xl font-bold text-ink">{book.name}</h1>
  <p class="mt-2 text-stone-500">
    {book.chapterCount} {unit}s ·{' '}
    {summarizedCount > 0
      ? `${summarizedCount} summarized`
      : 'no summaries yet'}
  </p>

  {bookSummary && <SummaryCard summary={bookSummary} />}

  <ul class="mt-6 grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-5">
    {
      chapterNums.map((num) => {
        const status = summaries.get(num);
        const hasSummary = status !== undefined;
        const dot =
          status === 'draft'
            ? 'bg-amber-500'
            : status === 'review'
              ? 'bg-blue-500'
              : null;
        return (
          <li>
            {hasSummary ? (
              <a
                href={`/${canon}/${book.slug}/${num}`}
                class="relative flex aspect-square items-center justify-center rounded-md border border-stone-300 bg-stone-50 text-lg font-semibold text-ink transition hover:border-accent hover:text-accent"
              >
                {num}
                {dot && (
                  <span
                    class:list={['absolute right-1.5 top-1.5 h-2 w-2 rounded-full', dot]}
                    aria-hidden="true"
                  />
                )}
              </a>
            ) : (
              <div
                class="flex aspect-square items-center justify-center rounded-md border border-dashed border-stone-200 text-lg text-stone-300"
                title="Summary coming soon"
              >
                {num}
              </div>
            )}
          </li>
        );
      })
    }
  </ul>

  <p class="mt-4 text-xs text-stone-400">
    Numbered tiles without a link don't have a summary yet. A small
    <span class="mx-0.5 inline-block h-2 w-2 rounded-full bg-amber-500 align-middle"></span>
    marks a draft awaiting review;
    <span class="mx-0.5 inline-block h-2 w-2 rounded-full bg-blue-500 align-middle"></span>
    marks one in review.
  </p>
</BaseLayout>
