---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CanonIcon from '../../components/CanonIcon.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Sources from '../../components/Sources.astro';
import LangNote from '../../components/LangNote.astro';
import LangNotes from '../../components/LangNotes.astro';
import TranslationCompare from '../../components/TranslationCompare.astro';
import VerseRef from '../../components/VerseRef.astro';
import ScriptureBlock from '../../components/ScriptureBlock.astro';
import { canons, canonSlugs, type CanonSlug } from '../../lib/canons';

export const getStaticPaths = (() => {
  return canonSlugs.map((canon) => ({ params: { canon }, props: { canon } }));
}) satisfies GetStaticPaths;

const { canon } = Astro.props as { canon: CanonSlug };
const canonData = canons[canon];

const all = await getCollection('chapters');
const summaryCount = (bookSlug: string) =>
  all.filter((e) => e.data.canon === canon && e.data.bookSlug === bookSlug).length;

const canonEntry = (await getCollection('canons')).find((e) => e.data.slug === canon);
const Content = canonEntry ? (await render(canonEntry)).Content : null;
const mdxComponents = { LangNote, LangNotes, TranslationCompare, VerseRef, ScriptureBlock };
---

<BaseLayout title={canonData.name}>
  <nav class="text-sm text-stone-500" aria-label="Breadcrumb">
    <a href="/" class="hover:text-accent">Home</a>
    <span class="mx-1.5 text-stone-400">&rsaquo;</span>
    <span class="text-stone-700">{canonData.name}</span>
  </nav>

  <div class="mt-4 text-center">
    <CanonIcon canon={canon} size={64} class="text-accent" />
    <h1 class="mt-3 text-3xl font-bold text-ink sm:text-4xl">
      {canonData.name}{
        canonEntry && <StatusBadge status={canonEntry.data.status} />
      }
    </h1>
    {canonEntry?.data.subtitle && (
      <p class="mt-2 font-serif text-xl text-stone-600 italic sm:text-2xl">
        {canonEntry.data.subtitle}
      </p>
    )}
    <p class="mt-2 text-sm text-stone-500">
      {canonData.books.length} book{canonData.books.length === 1 ? '' : 's'}
    </p>
  </div>

  {
    canonEntry && Content && (
      <>
        <section class="mt-6 rounded-lg border border-stone-200 bg-stone-50/70 p-5">
          <p class="text-lg leading-relaxed text-ink">{canonEntry.data.highlightSummary}</p>
        </section>

        {(canonEntry.data.spanNote || canonEntry.data.languageNote) && (
          <aside class="mt-4 space-y-1 rounded border border-stone-200 bg-stone-50/40 p-4 text-sm">
            {canonEntry.data.spanNote && (
              <p>
                <span class="font-semibold text-stone-600">Span:</span> {canonEntry.data.spanNote}
              </p>
            )}
            {canonEntry.data.languageNote && (
              <p>
                <span class="font-semibold text-stone-600">Language:</span>{' '}
                {canonEntry.data.languageNote}
              </p>
            )}
          </aside>
        )}

        <SectionDivider />

        <article class="prose prose-stone max-w-none">
          <Content components={mdxComponents} />
        </article>

        {canonEntry.data.sources.length > 0 && <Sources sources={canonEntry.data.sources} />}

        <SectionDivider />
      </>
    )
  }

  <h2 class="text-sm font-semibold tracking-wider text-stone-500 uppercase">
    Books in {canonData.name}
  </h2>
  <ul class="mt-3 divide-y divide-stone-200 border-y border-stone-200">
    {
      canonData.books.map((book) => {
        const n = summaryCount(book.slug);
        return (
          <li>
            <a
              href={`/${canon}/${book.slug}`}
              class="flex items-baseline justify-between gap-4 py-3 transition hover:text-accent"
            >
              <span class="font-medium">{book.name}</span>
              <span class="text-sm text-stone-500">
                {book.chapterCount} chapters
                {n > 0 && <span class="ml-2 text-accent">· {n} summarized</span>}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
