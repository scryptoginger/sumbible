---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Internal workflow page. It renders in `npm run dev` and on Vercel PREVIEW
// deploys, but redirects to the home page on the PRODUCTION deploy.
// import.meta.env.PROD is true for any build; VERCEL_ENV distinguishes
// 'production' from 'preview'. (robots.txt also disallows /review.)
const isProduction =
  import.meta.env.PROD && process.env.VERCEL_ENV === 'production';
if (isProduction) {
  return Astro.redirect('/');
}

const REPO = 'https://github.com/scryptoginger/sumbible';

const chapters = await getCollection('chapters');
const inProgress = chapters
  .filter((c) => c.data.status !== 'published')
  .sort((a, b) => {
    if (a.data.canon !== b.data.canon) return a.data.canon.localeCompare(b.data.canon);
    if (a.data.bookOrder !== b.data.bookOrder) return a.data.bookOrder - b.data.bookOrder;
    return a.data.chapter - b.data.chapter;
  });

const drafts = inProgress.filter((c) => c.data.status === 'draft');
const inReview = inProgress.filter((c) => c.data.status === 'review');

function chapterUrl(c: (typeof chapters)[number]): string {
  return `/${c.data.canon}/${c.data.bookSlug}/${c.data.chapter}`;
}
function editUrl(c: (typeof chapters)[number]): string {
  return `${REPO}/edit/main/src/content/chapters/${c.id}.mdx`;
}
function label(c: (typeof chapters)[number]): string {
  const book = c.data.canon === 'doctrine-and-covenants' ? 'D&C' : c.data.book;
  return `${book} ${c.data.chapter}`;
}
---

<BaseLayout title="Review queue" description="Chapters awaiting review." noindex={true}>
  <h1 class="text-3xl font-bold text-ink">Review queue</h1>
  <p class="mt-2 text-sm text-stone-500">
    Internal workflow page — chapters not yet published. Not linked from the
    site nav, and redirected away on the production deploy.
  </p>

  {
    [
      { heading: 'Drafts — awaiting first review', list: drafts },
      { heading: 'In review', list: inReview },
    ].map((group) => (
      <section class="mt-8">
        <h2 class="text-sm font-semibold tracking-wider text-stone-500 uppercase">
          {group.heading} ({group.list.length})
        </h2>
        {group.list.length === 0 ? (
          <p class="mt-2 text-stone-400 italic">None.</p>
        ) : (
          <ul class="mt-3 divide-y divide-stone-200 border-y border-stone-200">
            {group.list.map((c) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3">
                <a href={chapterUrl(c)} class="font-medium text-accent hover:underline">
                  {label(c)}
                  {c.data.title && <span class="text-stone-500 italic"> — {c.data.title}</span>}
                </a>
                <span class="text-xs text-stone-500">
                  {c.data.draftedOn && <>drafted {c.data.draftedOn}</>}
                  {c.data.draftedBy && <> by {c.data.draftedBy}</>}
                  {c.data.reviewedOn && <> · reviewed {c.data.reviewedOn}</>}
                  {c.data.reviewedBy && <> by {c.data.reviewedBy}</>}
                  <span class="mx-2 text-stone-300">|</span>
                  <a href={chapterUrl(c)} class="underline hover:text-accent">view</a>
                  <span class="mx-1 text-stone-300">·</span>
                  <a
                    href={editUrl(c)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-accent"
                  >
                    edit MDX
                  </a>
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</BaseLayout>
