---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sources from '../../components/Sources.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import Commentary from '../../components/Commentary.astro';
import SourceText from '../../components/SourceText.astro';
import VerseRef from '../../components/VerseRef.astro';
import LangNote from '../../components/LangNote.astro';
import LangNotes from '../../components/LangNotes.astro';
import TranslationCompare from '../../components/TranslationCompare.astro';
import ScriptureBlock from '../../components/ScriptureBlock.astro';
import { canons, type CanonSlug } from '../../lib/canons';

export const getStaticPaths = (async () => {
  const all = await getCollection('relatedTexts');
  return all.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const mdxComponents = {
  Commentary,
  SourceText,
  LangNote,
  LangNotes,
  TranslationCompare,
  VerseRef,
  ScriptureBlock,
};

// Long-form works split into installments (see relatedTextParts). Empty for
// ordinary single-page entries, in which case no parts index renders.
const allParts = await getCollection('relatedTextParts');
const parts = allParts
  .filter((p) => p.data.parentSlug === data.slug)
  .sort((a, b) => a.data.part - b.data.part);

const categoryLabel: Record<string, string> = {
  'ancient-extracanonical': 'Ancient Extracanonical',
  'pseudepigrapha': 'Pseudepigrapha',
  'historical-collection': 'Historical Collection',
  'lds-extracanonical': 'Latter-day Saint Extracanonical',
};

const canonName = (slug: CanonSlug) => canons[slug].name;
---

<BaseLayout title={data.name} noindex={data.status !== 'published'}>
  <nav class="text-sm text-stone-500" aria-label="Breadcrumb">
    <a href="/" class="hover:text-accent">Home</a>
    <span class="mx-1.5 text-stone-400">&rsaquo;</span>
    <a href="/related-texts" class="hover:text-accent">Related Texts</a>
    <span class="mx-1.5 text-stone-400">&rsaquo;</span>
    <span class="text-stone-700">{data.name}</span>
  </nav>

  <h1 class="mt-3 font-serif text-3xl font-bold text-ink sm:text-4xl">
    {data.name}
  </h1>
  <p class="mt-2 text-sm text-stone-500">
    {categoryLabel[data.category]}
    {data.approximateDate && <> &middot; {data.approximateDate}</>}
    {data.language && <> &middot; {data.language}</>}
  </p>

  <section class="mt-6 rounded-lg border border-stone-200 bg-stone-50/70 p-5">
    <p class="leading-relaxed text-ink">{data.highlightSummary}</p>
  </section>

  <SectionDivider />

  <article class="prose prose-stone max-w-none">
    <Content components={mdxComponents} />
  </article>

  {parts.length > 0 && (
    <section class="mt-10">
      <h2 class="text-sm font-semibold tracking-wider text-stone-500 uppercase">
        Read the full text
      </h2>
      <p class="mt-1 text-sm text-stone-500">
        {parts.length} installments. Each part carries its own summary and
        commentary, followed by the complete text of that installment.
      </p>
      <ol class="mt-4 divide-y divide-stone-200 border-y border-stone-200">
        {parts.map((p) => (
          <li>
            <a
              href={`/related-texts/${p.data.parentSlug}/${p.data.slug}`}
              class="flex flex-col gap-1 py-3 transition hover:text-accent sm:flex-row sm:items-baseline sm:justify-between sm:gap-4"
            >
              <span class="font-medium text-ink">
                <span class="text-stone-500">Part {p.data.part}.</span> {p.data.title}
              </span>
              {p.data.originalPublication && (
                <span class="shrink-0 text-sm text-stone-500">
                  {p.data.originalPublication}
                </span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  {data.canonicalReferences.length > 0 && (
    <section class="mt-8 rounded border border-stone-200 bg-stone-50/40 p-4">
      <h2 class="text-sm font-semibold tracking-wider text-stone-600 uppercase">
        Referenced in canonical scripture
      </h2>
      <ul class="mt-3 space-y-2 text-sm">
        {data.canonicalReferences.map((ref) => (
          <li>
            <VerseRef book={ref.book} chapter={ref.chapter} verse={ref.verse} />
            <span class="text-stone-500">
              {' '}&middot; {canonName(ref.canon as CanonSlug)}
              {ref.note && <> &middot; {ref.note}</>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {data.sources.length > 0 && <Sources sources={data.sources} />}
</BaseLayout>
