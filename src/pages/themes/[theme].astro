---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { canons, canonSlugs } from '../../lib/canons';

export const getStaticPaths = (async () => {
  const chapters = await getCollection('chapters');
  const themeSet = new Set<string>();
  for (const chapter of chapters) {
    for (const theme of chapter.data.themes) themeSet.add(theme);
  }
  return [...themeSet].map((theme) => ({ params: { theme }, props: { theme } }));
}) satisfies GetStaticPaths;

const { theme } = Astro.props as { theme: string };
const spaced = theme.replace(/-/g, ' ');
const humanTheme = spaced.charAt(0).toUpperCase() + spaced.slice(1);

const chapters = await getCollection('chapters');
const tagged = chapters
  .filter((c) => c.data.themes.includes(theme))
  .sort((a, b) => a.data.bookOrder - b.data.bookOrder || a.data.chapter - b.data.chapter);
---

<BaseLayout title={`Theme: ${humanTheme}`} description={`Chapters tagged "${theme}".`}>
  <nav class="text-sm text-stone-500" aria-label="Breadcrumb">
    <a href="/themes" class="hover:text-accent">Themes</a>
    <span class="mx-1.5 text-stone-400">&rsaquo;</span>
    <span class="text-stone-700">{humanTheme}</span>
  </nav>

  <h1 class="mt-3 text-3xl font-bold text-ink">{humanTheme}</h1>
  <p class="mt-2 text-sm text-stone-500">
    {tagged.length} {tagged.length === 1 ? 'chapter' : 'chapters'} tagged with this theme.
  </p>

  <div class="mt-6 space-y-6">
    {
      canonSlugs.map((canon) => {
        const inCanon = tagged.filter((c) => c.data.canon === canon);
        if (inCanon.length === 0) return null;
        return (
          <section>
            <h2 class="text-sm font-semibold tracking-wider text-stone-500 uppercase">
              {canons[canon].name}
            </h2>
            <ul class="mt-2 divide-y divide-stone-200 border-y border-stone-200">
              {inCanon.map((c: CollectionEntry<'chapters'>) => (
                <li class="py-2">
                  <a
                    href={`/${c.data.canon}/${c.data.bookSlug}/${c.data.chapter}`}
                    class="font-medium text-accent hover:underline"
                  >
                    {c.data.book} {c.data.chapter}
                    {c.data.title && <span class="text-stone-500 italic"> — {c.data.title}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</BaseLayout>
